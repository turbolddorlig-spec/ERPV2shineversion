# ERP V2 — орчны тохиргоо. install.sh автоматаар .env үүсгэнэ.
DATABASE_URL="postgresql://erp:CHANGE_ME@db:5432/erp?schema=public"
# Нэвтрэлтийн cookie-г https дээр л илгээх эсэх (production: true)
COOKIE_SECURE="true"
# Апп-ын нээлттэй хаяг, жишээ: https://v2.erpzahialga.com
APP_URL="http://localhost:3000"
