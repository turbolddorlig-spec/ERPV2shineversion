# SITE_ADDRESS-ийг docker-compose.yml тохируулна:
#  - Домэйнгүй үед ":80"  → зөвхөн HTTP, IP хаягаар нээгдэнэ, сертификат авах оролдлого ХИЙХГҮЙ.
#  - Домэйнтэй үед "v2.erpzahialga.com" → HTTPS сертификатыг автоматаар авч, сунгана.
{$SITE_ADDRESS} {
	encode gzip

	# Барааны зураг: дискнээс шууд (апп-ыг ачаалахгүй). Файлын нэр UUID тул өөрчлөгдөхгүй → удаан cache.
	handle_path /media/* {
		@img path_regexp ^/products/[0-9]+/[0-9a-f-]{36}-(sm|md|lg)\.webp$
		handle @img {
			root * /srv/media
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		respond 404
	}

	reverse_proxy app:3000
}
