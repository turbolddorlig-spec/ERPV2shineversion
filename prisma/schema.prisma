// zahialga• ERP V2 — Модуль 0 (Суурь)
// Энэ модульд зөвхөн нэвтрэх, хэрэглэгч, эрх, үйлдлийн түүх багтана.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 12 role (эзний шийдвэр #15). Нэг хэрэглэгч олон role-тэй байж болно (#18).
enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR_LEAD
  OPERATOR
  DRIVER_LEAD
  DRIVER
  ACCOUNTING
  WAREHOUSE
  MARKETING_LEAD
  MARKETING
  PENALTY_OFFICER
  SUPPLIER
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// 8 оронтой, зөвхөн тоо (нэвтрэх нэр)
  phone              String    @unique
  name               String
  passwordHash       String
  roles              Role[]
  isActive           Boolean   @default(true)
  /// Нууц үг сэргээсний дараа анх нэвтрэхдээ солих ёстой
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  theme              Theme     @default(SYSTEM)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime  @default(now())
  /// Захиалга үүсгэхэд сүүлд сонгосон пэйж (#50)
  lastPageId         Int?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions Session[]

  @@index([isActive])
  @@index([name])
}

/// Нэвтрэлт. Токены hash-ийг л хадгална. 30 хоног, ашиглах бүрт сунгагдана (#16).
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

/// Үйлдлийн түүх. Зөвхөн нэмэгдэнэ — засах, устгахыг database өөрөө хориглоно.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?  @db.Uuid
  /// Тухайн үеийн нэр (дараа нь нэр солигдсон ч түүх хэвээр)
  actorName  String
  action     String
  entityType String
  entityId   String?
  details    Json?
  ip         String?
  /// Шүүлтүүрт: жишээ нь ["price","code","status"] — чухал өөрчлөлтийг тодруулна
  tags       String[] @default([])

  @@index([at])
  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([entityType, at])
}

/// "Шалгасан" тэмдэглэгээ. AuditLog өөрөө засагдахгүй тул тусдаа хүснэгтэд.
model AuditReview {
  auditLogId     BigInt   @id
  reviewedById   String   @db.Uuid
  reviewedByName String
  reviewedAt     DateTime @default(now())
}

// ─────────────────────────── Модуль 1: Бараа ───────────────────────────

/// Идэвхтэй = зарна · Зогсоосон = дахин захиалахгүй, үлдсэнийг зарна · Архив = зарахгүй, нуугдана
enum ProductStatus {
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String    @default("gray")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Season {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          Int           @id @default(autoincrement())
  /// Давхардахгүй код (хуучин системийн кодууд хэвээр)
  code        String        @unique
  name        String
  description String?
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  seasonId    Int?
  season      Season?       @relation(fields: [seasonId], references: [id])
  /// Зарах үнэ, төгрөг
  price       Int
  /// Өртөг (авсан үнэ) — зөвхөн Супер админ, Админ харна
  costPrice   Int?
  status      ProductStatus @default(ACTIVE)
  statusNote  String?
  /// Хувилбарын тэнхлэгүүд. Хоёулаа хоосон бол нэг "үндсэн" хувилбартай.
  colors      String[]      @default([])
  sizes       String[]      @default([])
  /// Зэрэг засварт нэг нь нөгөөгөө чимээгүй дарахаас сэргийлнэ
  version     Int           @default(1)
  createdById String?       @db.Uuid
  updatedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// Үндсэн агуулахын тавиурын код («A-3») — бэлтгэлийн жагсаалт энэ дарааллаар (#38)
  shelfCode        String?
  /// Зарах үнэд хүргэлтийн төлбөр багтсан эсэх (#43). Үгүй бол захиалгад хүргэлтийн төлбөр нэмэгдэнэ
  deliveryIncluded Boolean @default(true)

  variants ProductVariant[]
  images   ProductImage[]

  @@index([status])
  @@index([shelfCode])
  @@index([categoryId])
  @@index([seasonId])
  @@index([updatedAt])
}

/// Үлдэгдэл тоологдох нэгж (SKU). Бараа бүр дор хаяж нэгтэй.
model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  code          String   @unique
  /// '' = өнгөгүй/хэмжээгүй
  color         String   @default("")
  size          String   @default("")
  /// Хоосон бол барааны үнэ
  priceOverride Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances StockBalance[]
  moves    StockMove[]

  @@unique([productId, color, size])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  /// '' = ерөнхий зураг, эсвэл барааны өнгөний нэр
  color     String   @default("")
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  /// Файлын суурь нэр: products/<productId>/<uuid> → -sm.webp, -md.webp, -lg.webp
  fileKey   String
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// ─────────────────────────── Модуль 2: Үлдэгдлийн журнал ───────────────────────────
// Үлдэгдэл = журнал (StockMove). Бараа хөдлөх бүрт мөр бичигдэнэ, засах/устгах боломжгүй.
// StockBalance нь журналын нийлбэрийн хурдан хуулбар (нэг гүйлгээнд хамт шинэчлэгдэнэ, сөрөг болохыг DB хориглоно).

model Warehouse {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  address   String?
  /// Захиалга энэ агуулахын тавиураас гарна (яг нэг)
  isPrimary Boolean        @default(false)
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  location  StockLocation?
}

enum LocationKind {
  WAREHOUSE
  TRANSIT
  STAFF
  DRIVER
}

/// Бараа байж болох газар: агуулах, замдаа (шилжүүлэг), ажилтны гарт (зээл), жолоочийн гарт (Модуль 4)
model StockLocation {
  id          Int            @id @default(autoincrement())
  kind        LocationKind
  warehouseId Int?           @unique
  warehouse   Warehouse?     @relation(fields: [warehouseId], references: [id])
  userId      String?        @db.Uuid
  name        String
  createdAt   DateTime       @default(now())
  balances    StockBalance[]

  @@unique([kind, userId])
}

model StockBalance {
  locationId Int
  location   StockLocation  @relation(fields: [locationId], references: [id])
  variantId  Int
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  qty        Int            @default(0)
  updatedAt  DateTime       @default(now())

  @@id([locationId, variantId])
  @@index([variantId])
}

enum MoveType {
  RECEIPT
  TRANSFER_SEND
  TRANSFER_RECEIVE
  TRANSFER_BACK
  TRANSFER_LOSS
  ISSUE
  COUNT_PLUS
  COUNT_MINUS
  LOAN_OUT
  LOAN_RETURN
  LOAN_CHARGE
}

/// Журнал: нэг мөр = нэг хувилбарын нэг хөдөлгөөн (хаанаас → хаашаа). fromId/toId хоосон = гаднаас / гадагш.
model StockMove {
  id        BigInt         @id @default(autoincrement())
  at        DateTime       @default(now())
  type      MoveType
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  qty       Int
  fromId    Int?
  toId      Int?
  /// receipt | issue | transfer | count | loan
  docType   String
  docId     Int
  note      String?
  actorId   String         @db.Uuid
  actorName String

  @@index([variantId, id])
  @@index([fromId, id])
  @@index([toId, id])
  @@index([at])
  @@index([docType, docId])
}

model StockReceipt {
  id            Int      @id @default(autoincrement())
  warehouseId   Int
  note          String?
  /// Давхар дарахаас хамгаалах түлхүүр
  idemKey       String   @unique
  createdById   String   @db.Uuid
  createdByName String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

enum IssueReason {
  DAMAGE
  SAMPLE
  SUPPLIER_RETURN
}

model StockIssue {
  id            Int         @id @default(autoincrement())
  warehouseId   Int
  reason        IssueReason
  note          String
  idemKey       String      @unique
  createdById   String      @db.Uuid
  createdByName String
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([reason, createdAt])
}

enum TransferStatus {
  SENT
  RECEIVED
  DISCREPANCY
  RESOLVED
  CANCELLED
}

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  fromWarehouseId Int
  toWarehouseId   Int
  status          TransferStatus      @default(SENT)
  note            String?
  /// Үндсэн агуулахын дүүргэлтээс үүссэн
  refill          Boolean             @default(false)
  idemKey         String              @unique
  sentById        String              @db.Uuid
  sentByName      String
  sentAt          DateTime            @default(now())
  receivedById    String?             @db.Uuid
  receivedByName  String?
  receivedAt      DateTime?
  resolvedById    String?             @db.Uuid
  resolvedByName  String?
  resolvedAt      DateTime?
  resolveNote     String?
  lines           StockTransferLine[]

  @@index([status, toWarehouseId])
  @@index([sentAt])
}

model StockTransferLine {
  id          Int           @id @default(autoincrement())
  transferId  Int
  transfer    StockTransfer @relation(fields: [transferId], references: [id])
  variantId   Int
  sentQty     Int
  receivedQty Int?
  /// Дутагдлыг шийдсэн: илгээгч рүү буцаасан / хорогдол
  returnedQty Int           @default(0)
  lostQty     Int           @default(0)

  @@unique([transferId, variantId])
}

enum CountStatus {
  OPEN
  SUBMITTED
  CLOSED
  CANCELLED
}

enum CountLineStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockCount {
  id            Int              @id @default(autoincrement())
  warehouseId   Int
  status        CountStatus      @default(OPEN)
  note          String?
  createdById   String           @db.Uuid
  createdByName String
  createdAt     DateTime         @default(now())
  submittedAt   DateTime?
  closedAt      DateTime?
  lines         StockCountLine[]

  @@index([status, warehouseId])
}

model StockCountLine {
  id            Int             @id @default(autoincrement())
  countId       Int
  count         StockCount      @relation(fields: [countId], references: [id])
  variantId     Int
  /// Тоолох үеийн системийн тоо
  systemQty     Int
  countedQty    Int
  countedAt     DateTime        @default(now())
  countedById   String          @db.Uuid
  countedByName String
  status        CountLineStatus @default(PENDING)
  appliedDelta  Int?
  decidedById   String?         @db.Uuid
  decidedByName String?
  decidedAt     DateTime?

  @@unique([countId, variantId])
}

enum LoanStatus {
  REQUESTED
  ISSUED
  CLOSED
  REJECTED
  CANCELLED
}

/// Ажилтны бараа зээл (#38): хүсэлт → агуулах олгоно → буцаалт / цалингаас суутгал
model StaffLoan {
  id           Int             @id @default(autoincrement())
  staffId      String          @db.Uuid
  staffName    String
  status       LoanStatus      @default(REQUESTED)
  note         String?
  warehouseId  Int?
  idemKey      String          @unique
  requestedAt  DateTime        @default(now())
  issuedById   String?         @db.Uuid
  issuedByName String?
  issuedAt     DateTime?
  decidedNote  String?
  closedAt     DateTime?
  lines        StaffLoanLine[]

  @@index([status, requestedAt])
  @@index([staffId, requestedAt])
}

model StaffLoanLine {
  id          Int       @id @default(autoincrement())
  loanId      Int
  loan        StaffLoan @relation(fields: [loanId], references: [id])
  variantId   Int
  qty         Int
  returnedQty Int       @default(0)
  chargedQty  Int       @default(0)
  /// Олгох үеийн зарах үнэ ба нэгжийн суутгал (үнэ − хямдрал), Супер админ / Нягтлан засна
  unitPrice   Int?
  deduction   Int?

  @@unique([loanId, variantId])
}

/// Захиалгын нөөцлөлт — Модуль 3 бичнэ. Үндсэн агуулахын дүүргэлтийн тооцоонд ашиглана.
model StockReservation {
  id        Int      @id @default(autoincrement())
  ref       String
  /// Захиалгын нөөц бол захиалгын id (Модуль 3)
  orderId   Int?
  variantId Int
  qty       Int
  createdAt DateTime @default(now())

  @@unique([ref, variantId])
  @@index([variantId])
  @@index([orderId])
}

/// Системийн тохиргоо (жишээ: loanDiscount = 5000)
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

/// Давхар дарахаас хамгаалах түлхүүр (нэг баримт дээрх давтагдах үйлдэлд: зээлийн хэсэгчилсэн буцаалт г.м.)
model IdemKey {
  key       String   @id
  createdAt DateTime @default(now())
}

// ─────────────────────────── Модуль 3: Захиалга ───────────────────────────

/// Facebook пэйж (#43, хуучин шиг)
model Page {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// Ахлах оператор операторт пэйж хуваарилна. Хуваарилалтгүй бол бүх идэвхтэй пэйж.
model PageAssignment {
  userId    String   @id @db.Uuid
  pageIds   Int[]    @default([])
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// 7 төлөв (#44, #45): «Он сар өдөртэй» = NEW + хүргэх өдөр маргаашаас хойш (тусдаа хадгалахгүй, автомат)
enum OrderStatus {
  PENDING_PAYMENT
  NEW
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CancelReason {
  CUSTOMER_CANCELLED
  DUPLICATE
  OUT_OF_STOCK
  NO_ANSWER
  PAYMENT_TIMEOUT
  OTHER
}

model Order {
  id                Int           @id @default(autoincrement())
  /// 8 оронтой хүний унших дугаар — хэзээ ч солигдохгүй (#43)
  number            String        @unique
  status            OrderStatus
  phone             String
  extraPhone        String?
  province          String
  district          String?
  /// Хороо (дугаар); null = «Хороо тодорхойгүй» (#43)
  khoroo            Int?
  addressDetail     String
  note              String?
  pageId            Int
  operatorId        String        @db.Uuid
  operatorName      String
  /// Хүргэх өдөр (#44): анхдагч маргааш
  deliveryDate      DateTime      @db.Date
  prepaid           Boolean       @default(false)
  /// Баталгаажсан мөч: УБ «Шинэ» үүсэхэд эсвэл «Мөнгө орсон»-д. Тайлан, цагийн мэдээ, Meta үүгээр
  confirmedAt       DateTime?
  /// Төлбөр хүлээж буй захиалгын хугацаа (дуусахад автомат цуцлагдана)
  paymentDeadline   DateTime?
  /// Барааны нийт (жагсаалтын үнээр), хөнгөлөлт, хүргэлт, төлөх дүн — сервер тооцно
  subtotal          Int
  discount          Int           @default(0)
  deliveryFee       Int           @default(0)
  total             Int
  /// Хүргэлтийн төлбөрийг оператор өөрчилсөн (Супер админ шалгана)
  deliveryFeeEdited Boolean       @default(false)
  /// Хар жагсаалттай утсаар авахдаа бичсэн шалтгаан
  blacklistNote     String?
  /// Жолооч «Маргааш» дарсан тоо (Модуль 5)
  postponeCount     Int           @default(0)
  /// Падаанд орсон (Модуль 4) — бараа засахгүй
  handoverId        Int?
  cancelReason      CancelReason?
  cancelNote        String?
  cancelledAt       DateTime?
  cancelledByName   String?
  deliveredAt       DateTime?
  /// Давхар дарах / сүлжээ тасрахаас хамгаалах (#47)
  idemKey           String        @unique
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lines             OrderLine[]

  @@index([status, deliveryDate])
  @@index([status, createdAt])
  @@index([confirmedAt])
  @@index([createdAt])
  @@index([phone])
  @@index([extraPhone])
  @@index([pageId, confirmedAt])
  @@index([operatorId, confirmedAt])
  @@index([status, paymentDeadline])
}

/// Захиалгын мөр — барааны хуулбар (#28)
model OrderLine {
  id               Int     @id @default(autoincrement())
  orderId          Int
  order            Order   @relation(fields: [orderId], references: [id])
  variantId        Int
  productId        Int
  code             String
  name             String
  label            String
  imageKey         String?
  listPrice        Int
  unitPrice        Int
  qty              Int
  discountReason   String?
  deliveryIncluded Boolean @default(true)

  @@unique([orderId, variantId])
  @@index([variantId])
}

/// Хар жагсаалт (#43): анхааруулна; ахлах / админ удирдана; жолооч нэмнэ (Модуль 5)
model BlacklistEntry {
  id           Int       @id @default(autoincrement())
  phone        String
  reason       String
  orderNumber  String?
  reportedById String?   @db.Uuid
  reportedBy   String
  isActive     Boolean   @default(true)
  removedBy    String?
  removedAt    DateTime?
  removeNote   String?
  createdAt    DateTime  @default(now())

  @@index([phone, isActive])
  @@index([createdAt])
}

enum CallStatus {
  PENDING
  CONTACTED
  ORDERED
  CANCELLED
  TRANSFERRED
}

enum CallCloseReason {
  NO_ANSWER
  PRICE
  OUT_OF_STOCK
  NO_SIZE_COLOR
  DELIVERY
  JUST_ASKING
  BOUGHT_ELSEWHERE
  OTHER
}

/// Дуудлагын бүртгэл (хуучин логик) + хаах шалтгаан (#54)
model CallNote {
  id            Int                @id @default(autoincrement())
  phone         String
  variantId     Int?
  productText   String?
  pageId        Int?
  note          String?
  status        CallStatus         @default(PENDING)
  ownerId       String             @db.Uuid
  ownerName     String
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  orderId       Int?
  closeReason   CallCloseReason?
  closeNote     String?
  closedAt      DateTime?
  createdById   String             @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transfers     CallNoteTransfer[]

  @@index([ownerId, status])
  @@index([phone])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum TransferRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CallNoteTransfer {
  id        Int                   @id @default(autoincrement())
  noteId    Int
  note      CallNote              @relation(fields: [noteId], references: [id])
  fromId    String                @db.Uuid
  fromName  String
  toId      String                @db.Uuid
  toName    String
  status    TransferRequestStatus @default(PENDING)
  createdAt DateTime              @default(now())
  decidedAt DateTime?

  @@index([toId, status])
  @@index([noteId])
}

enum MetaEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Meta CAPI Purchase (#43): баталгаажсан захиалгад нэг л удаа; алдаа гарвал дахин илгээнэ
model MetaEvent {
  id            Int             @id @default(autoincrement())
  orderId       Int             @unique
  status        MetaEventStatus @default(PENDING)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, nextAttemptAt])
}
