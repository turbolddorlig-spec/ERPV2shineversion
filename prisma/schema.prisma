// zahialga• ERP V2 — Модуль 0 (Суурь)
// Энэ модульд зөвхөн нэвтрэх, хэрэглэгч, эрх, үйлдлийн түүх багтана.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 12 role (эзний шийдвэр #15). Нэг хэрэглэгч олон role-тэй байж болно (#18).
enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR_LEAD
  OPERATOR
  DRIVER_LEAD
  DRIVER
  ACCOUNTING
  WAREHOUSE
  MARKETING_LEAD
  MARKETING
  PENALTY_OFFICER
  SUPPLIER
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// 8 оронтой, зөвхөн тоо (нэвтрэх нэр)
  phone              String    @unique
  name               String
  passwordHash       String
  roles              Role[]
  isActive           Boolean   @default(true)
  /// Нууц үг сэргээсний дараа анх нэвтрэхдээ солих ёстой
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  theme              Theme     @default(SYSTEM)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime  @default(now())
  /// Захиалга үүсгэхэд сүүлд сонгосон пэйж (#50)
  lastPageId         Int?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions Session[]

  @@index([isActive])
  @@index([name])
}

/// Нэвтрэлт. Токены hash-ийг л хадгална. 30 хоног, ашиглах бүрт сунгагдана (#16).
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

/// Үйлдлийн түүх. Зөвхөн нэмэгдэнэ — засах, устгахыг database өөрөө хориглоно.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?  @db.Uuid
  /// Тухайн үеийн нэр (дараа нь нэр солигдсон ч түүх хэвээр)
  actorName  String
  action     String
  entityType String
  entityId   String?
  details    Json?
  ip         String?
  /// Шүүлтүүрт: жишээ нь ["price","code","status"] — чухал өөрчлөлтийг тодруулна
  tags       String[] @default([])

  @@index([at])
  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([entityType, at])
}

/// "Шалгасан" тэмдэглэгээ. AuditLog өөрөө засагдахгүй тул тусдаа хүснэгтэд.
model AuditReview {
  auditLogId     BigInt   @id
  reviewedById   String   @db.Uuid
  reviewedByName String
  reviewedAt     DateTime @default(now())
}

// ─────────────────────────── Модуль 1: Бараа ───────────────────────────

/// Идэвхтэй = зарна · Зогсоосон = дахин захиалахгүй, үлдсэнийг зарна · Архив = зарахгүй, нуугдана
enum ProductStatus {
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String    @default("gray")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Season {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          Int           @id @default(autoincrement())
  /// Давхардахгүй код (хуучин системийн кодууд хэвээр)
  code        String        @unique
  name        String
  description String?
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  seasonId    Int?
  season      Season?       @relation(fields: [seasonId], references: [id])
  /// Зарах үнэ, төгрөг
  price       Int
  /// Өртөг (авсан үнэ) — зөвхөн Супер админ, Админ харна
  costPrice   Int?
  status      ProductStatus @default(ACTIVE)
  statusNote  String?
  /// Хувилбарын тэнхлэгүүд. Хоёулаа хоосон бол нэг "үндсэн" хувилбартай.
  colors      String[]      @default([])
  sizes       String[]      @default([])
  /// Зэрэг засварт нэг нь нөгөөгөө чимээгүй дарахаас сэргийлнэ
  version     Int           @default(1)
  createdById String?       @db.Uuid
  updatedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// Үндсэн агуулахын тавиурын код («A-3») — бэлтгэлийн жагсаалт энэ дарааллаар (#38)
  shelfCode        String?
  /// Зарах үнэд хүргэлтийн төлбөр багтсан эсэх (#43). Үгүй бол захиалгад хүргэлтийн төлбөр нэмэгдэнэ
  deliveryIncluded Boolean @default(true)

  variants ProductVariant[]
  images   ProductImage[]

  @@index([status])
  @@index([shelfCode])
  @@index([categoryId])
  @@index([seasonId])
  @@index([updatedAt])
}

/// Үлдэгдэл тоологдох нэгж (SKU). Бараа бүр дор хаяж нэгтэй.
model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  code          String   @unique
  /// '' = өнгөгүй/хэмжээгүй
  color         String   @default("")
  size          String   @default("")
  /// Хоосон бол барааны үнэ
  priceOverride Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances StockBalance[]
  moves    StockMove[]

  @@unique([productId, color, size])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  /// '' = ерөнхий зураг, эсвэл барааны өнгөний нэр
  color     String   @default("")
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  /// Файлын суурь нэр: products/<productId>/<uuid> → -sm.webp, -md.webp, -lg.webp
  fileKey   String
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// ─────────────────────────── Модуль 2: Үлдэгдлийн журнал ───────────────────────────
// Үлдэгдэл = журнал (StockMove). Бараа хөдлөх бүрт мөр бичигдэнэ, засах/устгах боломжгүй.
// StockBalance нь журналын нийлбэрийн хурдан хуулбар (нэг гүйлгээнд хамт шинэчлэгдэнэ, сөрөг болохыг DB хориглоно).

model Warehouse {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  address   String?
  /// Захиалга энэ агуулахын тавиураас гарна (яг нэг)
  isPrimary Boolean        @default(false)
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  location  StockLocation?
}

enum LocationKind {
  WAREHOUSE
  TRANSIT
  STAFF
  DRIVER
}

/// Бараа байж болох газар: агуулах, замдаа (шилжүүлэг), ажилтны гарт (зээл), жолоочийн гарт (Модуль 4)
model StockLocation {
  id          Int            @id @default(autoincrement())
  kind        LocationKind
  warehouseId Int?           @unique
  warehouse   Warehouse?     @relation(fields: [warehouseId], references: [id])
  userId      String?        @db.Uuid
  name        String
  createdAt   DateTime       @default(now())
  balances    StockBalance[]

  @@unique([kind, userId])
}

model StockBalance {
  locationId Int
  location   StockLocation  @relation(fields: [locationId], references: [id])
  variantId  Int
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  qty        Int            @default(0)
  updatedAt  DateTime       @default(now())

  @@id([locationId, variantId])
  @@index([variantId])
}

enum MoveType {
  RECEIPT
  TRANSFER_SEND
  TRANSFER_RECEIVE
  TRANSFER_BACK
  TRANSFER_LOSS
  ISSUE
  COUNT_PLUS
  COUNT_MINUS
  LOAN_OUT
  LOAN_RETURN
  LOAN_CHARGE
  /// Модуль 4: агуулах → жолооч (падаан «Барааг бүрэн өгсөн»), буцаах
  HANDOVER
  HANDOVER_BACK
  /// Модуль 5: жолооч → үйлчлүүлэгч (хүргэсэн), буцаан авсан (хүргэсний дараа цуцалсан)
  DELIVERY
  DELIVERY_BACK
  /// Модуль 5: жолоочоос агуулахад буцаалт хүлээн авсан
  DRIVER_RETURN
  /// Модуль 5: нэмэлт бараа — агуулах → жолооч, жолооч зарсан
  EXTRA_OUT
  EXTRA_SALE
}

/// Журнал: нэг мөр = нэг хувилбарын нэг хөдөлгөөн (хаанаас → хаашаа). fromId/toId хоосон = гаднаас / гадагш.
model StockMove {
  id        BigInt         @id @default(autoincrement())
  at        DateTime       @default(now())
  type      MoveType
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  qty       Int
  fromId    Int?
  toId      Int?
  /// receipt | issue | transfer | count | loan
  docType   String
  docId     Int
  note      String?
  actorId   String         @db.Uuid
  actorName String

  @@index([variantId, id])
  @@index([fromId, id])
  @@index([toId, id])
  @@index([at])
  @@index([docType, docId])
}

model StockReceipt {
  id            Int      @id @default(autoincrement())
  warehouseId   Int
  note          String?
  /// Давхар дарахаас хамгаалах түлхүүр
  idemKey       String   @unique
  createdById   String   @db.Uuid
  createdByName String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

enum IssueReason {
  DAMAGE
  SAMPLE
  SUPPLIER_RETURN
}

model StockIssue {
  id            Int         @id @default(autoincrement())
  warehouseId   Int
  reason        IssueReason
  note          String
  idemKey       String      @unique
  createdById   String      @db.Uuid
  createdByName String
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([reason, createdAt])
}

enum TransferStatus {
  SENT
  RECEIVED
  DISCREPANCY
  RESOLVED
  CANCELLED
}

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  fromWarehouseId Int
  toWarehouseId   Int
  status          TransferStatus      @default(SENT)
  note            String?
  /// Үндсэн агуулахын дүүргэлтээс үүссэн
  refill          Boolean             @default(false)
  idemKey         String              @unique
  sentById        String              @db.Uuid
  sentByName      String
  sentAt          DateTime            @default(now())
  receivedById    String?             @db.Uuid
  receivedByName  String?
  receivedAt      DateTime?
  resolvedById    String?             @db.Uuid
  resolvedByName  String?
  resolvedAt      DateTime?
  resolveNote     String?
  lines           StockTransferLine[]

  @@index([status, toWarehouseId])
  @@index([sentAt])
}

model StockTransferLine {
  id          Int           @id @default(autoincrement())
  transferId  Int
  transfer    StockTransfer @relation(fields: [transferId], references: [id])
  variantId   Int
  sentQty     Int
  receivedQty Int?
  /// Дутагдлыг шийдсэн: илгээгч рүү буцаасан / хорогдол
  returnedQty Int           @default(0)
  lostQty     Int           @default(0)

  @@unique([transferId, variantId])
}

enum CountStatus {
  OPEN
  SUBMITTED
  CLOSED
  CANCELLED
}

enum CountLineStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockCount {
  id            Int              @id @default(autoincrement())
  warehouseId   Int
  status        CountStatus      @default(OPEN)
  note          String?
  createdById   String           @db.Uuid
  createdByName String
  createdAt     DateTime         @default(now())
  submittedAt   DateTime?
  closedAt      DateTime?
  lines         StockCountLine[]

  @@index([status, warehouseId])
}

model StockCountLine {
  id            Int             @id @default(autoincrement())
  countId       Int
  count         StockCount      @relation(fields: [countId], references: [id])
  variantId     Int
  /// Тоолох үеийн системийн тоо
  systemQty     Int
  countedQty    Int
  countedAt     DateTime        @default(now())
  countedById   String          @db.Uuid
  countedByName String
  status        CountLineStatus @default(PENDING)
  appliedDelta  Int?
  decidedById   String?         @db.Uuid
  decidedByName String?
  decidedAt     DateTime?

  @@unique([countId, variantId])
}

enum LoanStatus {
  REQUESTED
  ISSUED
  CLOSED
  REJECTED
  CANCELLED
}

/// Ажилтны бараа зээл (#38): хүсэлт → агуулах олгоно → буцаалт / цалингаас суутгал
model StaffLoan {
  id           Int             @id @default(autoincrement())
  staffId      String          @db.Uuid
  staffName    String
  status       LoanStatus      @default(REQUESTED)
  note         String?
  warehouseId  Int?
  idemKey      String          @unique
  requestedAt  DateTime        @default(now())
  issuedById   String?         @db.Uuid
  issuedByName String?
  issuedAt     DateTime?
  decidedNote  String?
  closedAt     DateTime?
  lines        StaffLoanLine[]

  @@index([status, requestedAt])
  @@index([staffId, requestedAt])
}

model StaffLoanLine {
  id          Int       @id @default(autoincrement())
  loanId      Int
  loan        StaffLoan @relation(fields: [loanId], references: [id])
  variantId   Int
  qty         Int
  returnedQty Int       @default(0)
  chargedQty  Int       @default(0)
  /// Олгох үеийн зарах үнэ ба нэгжийн суутгал (үнэ − хямдрал), Супер админ / Нягтлан засна
  unitPrice   Int?
  deduction   Int?

  @@unique([loanId, variantId])
}

/// Захиалгын нөөцлөлт — Модуль 3 бичнэ. Үндсэн агуулахын дүүргэлтийн тооцоонд ашиглана.
model StockReservation {
  id        Int      @id @default(autoincrement())
  ref       String
  /// Захиалгын нөөц бол захиалгын id (Модуль 3)
  orderId   Int?
  variantId Int
  qty       Int
  createdAt DateTime @default(now())

  @@unique([ref, variantId])
  @@index([variantId])
  @@index([orderId])
}

/// Системийн тохиргоо (жишээ: loanDiscount = 5000)
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

/// Давхар дарахаас хамгаалах түлхүүр (нэг баримт дээрх давтагдах үйлдэлд: зээлийн хэсэгчилсэн буцаалт г.м.)
model IdemKey {
  key       String   @id
  createdAt DateTime @default(now())
}

// ─────────────────────────── Модуль 3: Захиалга ───────────────────────────

/// Facebook пэйж (#43, хуучин шиг)
model Page {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// Ахлах оператор операторт пэйж хуваарилна. Хуваарилалтгүй бол бүх идэвхтэй пэйж.
model PageAssignment {
  userId    String   @id @db.Uuid
  pageIds   Int[]    @default([])
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// 7 төлөв (#44, #45): «Он сар өдөртэй» = NEW + хүргэх өдөр маргаашаас хойш (тусдаа хадгалахгүй, автомат)
enum OrderStatus {
  PENDING_PAYMENT
  NEW
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CancelReason {
  CUSTOMER_CANCELLED
  DUPLICATE
  OUT_OF_STOCK
  NO_ANSWER
  PAYMENT_TIMEOUT
  OTHER
  /// Модуль 5: жолооч цуцалсан (шалтгаан тайлбарт)
  DRIVER_CANCELLED
  /// Модуль 5: «Опп-руу явуулах» асуудлаар цуцлагдсан
  ISSUE
}

/// Модуль 5: «Хүргэсэн» үед үйлчлүүлэгчийн төлбөр (хуучин шиг)
enum DeliveryPayment {
  CASH
  BANK
  UNPAID
  PREPAID
}

/// Модуль 5: жолоочийн «Опп-руу явуулах» (хуучин шиг)
enum IssueType {
  WRONG_PRODUCT
  WRONG_NUMBER
  UNCLEAR_ADDRESS
}

enum IssueStatus {
  PENDING
  FIXED
  CANCELLED
}

/// Асуудлаар цуцлахад хэний алдаа (торгууль — Модуль 7)
enum IssueFault {
  OPERATOR
  DRIVER
  MARKETING
  WAREHOUSE
}

/// Модуль 5: жолоочийн барааны баримт — буцаалт хүлээн авсан, нэмэлт бараа авсан, нэмэлт бараа зарсан
enum DriverDocKind {
  RETURN
  EXTRA_TAKE
  EXTRA_SALE
}

model DriverDoc {
  id         Int              @id @default(autoincrement())
  kind       DriverDocKind
  driverId   String           @db.Uuid
  driverName String
  byId       String           @db.Uuid
  byName     String
  note       String?
  /// Нэмэлт бараа зарсан: төлбөр, нийт (системийн үнээр)
  payment    DeliveryPayment?
  total      Int              @default(0)
  idemKey    String           @unique
  createdAt  DateTime         @default(now())
  /// Нэмэлт бараа (EXTRA_TAKE, #80): REQUESTED (хүсэлт, падаанд хүлээгдэж) → GIVEN (падаанаар жолооч хүлээн авсан) | CANCELLED; бусад баримт DONE
  status     String           @default("DONE")
  /// Нэмэлт барааны хүсэлт аль өдрийн падаанд орох вэ
  date       DateTime?        @db.Date
  handoverId Int?
  lines      DriverDocLine[]

  @@index([driverId, createdAt])
  @@index([kind, createdAt])
  @@index([handoverId])
  @@index([driverId, status])
}

model DriverDocLine {
  id        Int       @id @default(autoincrement())
  docId     Int
  doc       DriverDoc @relation(fields: [docId], references: [id])
  variantId Int
  qty       Int
  /// Буцаалт: хүлээгдэж байсан тоо (дутуу = expected − qty)
  expected  Int       @default(0)
  unitPrice Int       @default(0)

  @@index([docId])
  @@index([variantId])
}

model Order {
  id                  Int              @id @default(autoincrement())
  /// 8 оронтой хүний унших дугаар — хэзээ ч солигдохгүй (#43)
  number              String           @unique
  status              OrderStatus
  phone               String
  extraPhone          String?
  province            String
  district            String?
  /// Хороо (дугаар); null = «Хороо тодорхойгүй» (#43)
  khoroo              Int?
  addressDetail       String
  note                String?
  pageId              Int
  operatorId          String           @db.Uuid
  operatorName        String
  /// Хүргэх өдөр (#44): анхдагч маргааш
  deliveryDate        DateTime         @db.Date
  prepaid             Boolean          @default(false)
  /// Төлсөн дүн (#124): «Мөнгө орсон» үед — гараар бол тэр үеийн нийт дүн, банкаар бол гүйлгээний нийлбэр. Дүн өсвөл «Төлбөр хүлээж буй», буурвал илүү төлөлт
  paidAmount          Int              @default(0)
  /// Баталгаажсан мөч: УБ «Шинэ» үүсэхэд эсвэл «Мөнгө орсон»-д. Тайлан, цагийн мэдээ, Meta үүгээр
  confirmedAt         DateTime?
  /// Төлбөр хүлээж буй захиалгын хугацаа (дуусахад автомат цуцлагдана)
  paymentDeadline     DateTime?
  /// Барааны нийт (жагсаалтын үнээр), хөнгөлөлт, хүргэлт, төлөх дүн — сервер тооцно
  subtotal            Int
  discount            Int              @default(0)
  deliveryFee         Int              @default(0)
  total               Int
  /// Хүргэлтийн төлбөрийг оператор өөрчилсөн (Супер админ шалгана)
  deliveryFeeEdited   Boolean          @default(false)
  /// Хар жагсаалттай утсаар авахдаа бичсэн шалтгаан
  blacklistNote       String?
  /// Жолооч «Маргааш» дарсан тоо (Модуль 5)
  postponeCount       Int              @default(0)
  /// Падаанд орсон (Модуль 4) — захиалга засахгүй (хуучин шиг)
  handoverId          Int?
  /// Хуваарилсан жолооч (Модуль 4, ахлах жолооч). Хүргэх өдөр = deliveryDate
  driverId            String?          @db.Uuid
  driverName          String?
  assignedAt          DateTime?
  /// Агуулах «Барааг бүрэн өгсөн» дарсан мөч (бараа жолоочид шилжсэн)
  outForDeliveryAt    DateTime?
  cancelReason        CancelReason?
  cancelNote          String?
  cancelledAt         DateTime?
  cancelledByName     String?
  deliveredAt         DateTime?
  /// Модуль 5: «Хүргэсэн» — төлбөр, тайлбар, жолоочийн авсан дүн, хэсэгчилсэн хүргэлтийн өмнөх дүн
  deliveryPayment     DeliveryPayment?
  deliveryNote        String?
  collectAmount       Int?
  originalTotal       Int?
  deliveredByName     String?
  /// Модуль 5: «Маргааш» дарсан жолооч, мөч (захиалга «Шинэ» болж жолоочгүй болно; бараа тэр жолоочид)
  postponedAt         DateTime?
  postponedByDriverId String?          @db.Uuid
  postponedByName     String?
  /// Жолоочийн өөрийн дарааллын дугаар («#», хуучин шиг)
  routeNo             Int?
  /// Модуль 5: «Опп-руу явуулах»
  issueType           IssueType?
  issueNote           String?
  issueAt             DateTime?
  issueStatus         IssueStatus?
  issueFault          IssueFault?
  issueResolvedAt     DateTime?
  issueResolvedByName String?
  issueResolveNote    String?
  /// Давхар дарах / сүлжээ тасрахаас хамгаалах (#47)
  idemKey             String           @unique
  version             Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  lines               OrderLine[]

  @@index([status, deliveryDate])
  @@index([driverId, deliveryDate])
  @@index([status, createdAt])
  @@index([confirmedAt])
  @@index([createdAt])
  @@index([phone])
  @@index([extraPhone])
  @@index([pageId, confirmedAt])
  @@index([operatorId, confirmedAt])
  @@index([status, paymentDeadline])
  @@index([driverId, deliveredAt])
  @@index([driverId, cancelledAt])
  @@index([postponedByDriverId, postponedAt])
  @@index([issueStatus, issueAt])
}

/// Захиалгын мөр — барааны хуулбар (#28)
model OrderLine {
  id               Int     @id @default(autoincrement())
  orderId          Int
  order            Order   @relation(fields: [orderId], references: [id])
  variantId        Int
  productId        Int
  code             String
  name             String
  label            String
  imageKey         String?
  listPrice        Int
  unitPrice        Int
  qty              Int
  discountReason   String?
  deliveryIncluded Boolean @default(true)
  /// Модуль 5: үйлчлүүлэгч болиулсан тоо («Хүргэсэн» дээр чагтаа авсан) — жолоочид үлдэж агуулахад буцна
  refusedQty       Int     @default(0)

  @@unique([orderId, variantId])
  @@index([variantId])
}

/// Хар жагсаалт (#43): анхааруулна; ахлах / админ удирдана; жолооч нэмнэ (Модуль 5)
model BlacklistEntry {
  id           Int       @id @default(autoincrement())
  phone        String
  reason       String
  orderNumber  String?
  reportedById String?   @db.Uuid
  reportedBy   String
  isActive     Boolean   @default(true)
  removedBy    String?
  removedAt    DateTime?
  removeNote   String?
  createdAt    DateTime  @default(now())

  @@index([phone, isActive])
  @@index([createdAt])
}

enum CallStatus {
  PENDING
  CONTACTED
  ORDERED
  CANCELLED
  TRANSFERRED
}

enum CallCloseReason {
  NO_ANSWER
  PRICE
  OUT_OF_STOCK
  NO_SIZE_COLOR
  DELIVERY
  JUST_ASKING
  BOUGHT_ELSEWHERE
  OTHER
}

/// Дуудлагын бүртгэл (хуучин логик) + хаах шалтгаан (#54)
model CallNote {
  id            Int                @id @default(autoincrement())
  phone         String
  variantId     Int?
  productText   String?
  pageId        Int?
  note          String?
  status        CallStatus         @default(PENDING)
  ownerId       String             @db.Uuid
  ownerName     String
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  orderId       Int?
  closeReason   CallCloseReason?
  closeNote     String?
  closedAt      DateTime?
  createdById   String             @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transfers     CallNoteTransfer[]

  @@index([ownerId, status])
  @@index([phone])
  @@index([createdAt])
  @@index([status, createdAt])
}

enum TransferRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CallNoteTransfer {
  id        Int                   @id @default(autoincrement())
  noteId    Int
  note      CallNote              @relation(fields: [noteId], references: [id])
  fromId    String                @db.Uuid
  fromName  String
  toId      String                @db.Uuid
  toName    String
  status    TransferRequestStatus @default(PENDING)
  createdAt DateTime              @default(now())
  decidedAt DateTime?

  @@index([toId, status])
  @@index([noteId])
}

enum MetaEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Meta CAPI Purchase (#43): баталгаажсан захиалгад нэг л удаа; алдаа гарвал дахин илгээнэ
model MetaEvent {
  id            Int             @id @default(autoincrement())
  orderId       Int             @unique
  status        MetaEventStatus @default(PENDING)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, nextAttemptAt])
}

// ───────────────────────── Модуль 4: Падаан ─────────────────────────

/// Хуучин ERP шиг: Ноорог → Бэлтгэсэн → Өгсөн (жолоочийн хүлээн авалт Модуль 5-д)
enum HandoverStatus {
  DRAFT
  PREPARED
  /// Агуулах «Барааг бүрэн өгсөн» — жолооч утсаараа хүлээн авахыг хүлээж байна (бараа агуулахад)
  HANDED_OVER
  /// Жолооч «Барааг бүрэн хүлээн авсан» — бараа жолоочид шилжсэн, захиалгууд хүргэлтэд (#77)
  RECEIVED
}

/// Падаан — нэг жолоочид нэг өдөрт нэг (database-ээр хамгаална)
model Handover {
  id            Int             @id @default(autoincrement())
  /// П-000001 — хүний унших дугаар
  number        String          @unique
  date          DateTime        @db.Date
  driverId      String          @db.Uuid
  driverName    String
  /// Бараа гарах агуулах (үндсэн)
  warehouseId   Int
  status        HandoverStatus  @default(DRAFT)
  createdById   String          @db.Uuid
  createdByName String
  preparedAt    DateTime?
  preparedBy    String?
  /// Модуль 7а: бэлдсэн агуулахын ажилтан (агуулахын алдааны торгууль)
  preparedById  String?         @db.Uuid
  handedOverAt  DateTime?
  handedOverBy  String?
  receivedAt    DateTime?
  receivedBy    String?
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        HandoverOrder[]
  checks        HandoverCheck[]

  @@unique([driverId, date])
  @@index([date])
  @@index([status, date])
}

/// Падааны захиалга. orderId давхардахгүй — нэг захиалга нэг падаанд. removedAt: өгөхөөс өмнө цуцлагдсан/шилжсэн (агуулахад улаанаар)
model HandoverOrder {
  id           Int       @id @default(autoincrement())
  handoverId   Int
  handover     Handover  @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  orderId      Int
  position     Int
  addedAt      DateTime  @default(now())
  removedAt    DateTime?
  removeReason String?

  @@unique([handoverId, orderId])
  @@index([orderId])
}

/// Агуулахын Check — нэгтгэсэн бараа (хувилбар) бүрээр
model HandoverCheck {
  handoverId      Int
  handover        Handover  @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  variantId       Int
  checkedAt       DateTime  @default(now())
  checkedBy       String
  /// Жолооч утсаараа чагталсан (#77)
  driverCheckedAt DateTime?
  /// ORDER — захиалгын бараа; EXTRA — жолоочийн нэмэлт барааны хүсэлт (#80, падаанд тусдаа)
  kind            String    @default("ORDER")

  @@id([handoverId, variantId, kind])
}

/// Нягтлангийн өдрийн зөвшөөрөл (хуучин ERP-ийн OKEY / ХОРИГ). Итгэлтэй жолоочид автоматаар OKEY
model DriverApproval {
  driverId String   @db.Uuid
  date     DateTime @db.Date
  approved Boolean
  note     String?
  byName   String
  at       DateTime @default(now())

  @@id([driverId, date])
}

model DriverSetting {
  userId    String   @id @db.Uuid
  /// Итгэлтэй жолооч — нягтлан тэмдэглэхгүй ч өдөр бүр OKEY
  trusted   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Модуль 5 (#79): жолоочийн ХУВИЙН «Өрийн дэвтэр» (хуучин ERP шиг) — «Хүргэсэн» дээр «Төлөөгүй» дарахад үүснэ,
/// үйлчлүүлэгч мөнгөө өгөхөд жолооч «Төлсөн» дарна. Нягтлангийн тооцоотой холбоогүй.
model DriverDebt {
  id          Int       @id @default(autoincrement())
  orderId     Int
  driverId    String    @db.Uuid
  orderNumber String
  phone       String
  amount      Int
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  /// «Цуцлах (буцаах)»-аар хүргэлт буцсан бол дэвтрээс хасагдана
  cancelledAt DateTime?

  @@index([driverId, paidAt])
  @@index([orderId])
}

// ───────────────────────── Модуль 6: Нягтлан (#82, #83) ─────────────────────────

/// Тооцоо нийлэх (хуучин шиг): Ноорог → Жолооч илгээсэн → Нягтлан баталгаажуулсан (түгжигдэнэ)
enum SettlementStatus {
  DRAFT
  PENDING
  COMPLETED
}

/// Жолоочийн өдрийн тооцоо — өдөр = ПАДААНЫ өдөр (#83). Жолооч + өдөр давтагдашгүй
model DriverSettlement {
  id                Int              @id @default(autoincrement())
  driverId          String           @db.Uuid
  driverName        String
  date              DateTime         @db.Date
  status            SettlementStatus @default(DRAFT)
  cashAmount        Int              @default(0)
  bankAmount        Int              @default(0)
  debtAmount        Int              @default(0)
  /// Жолооч илгээх үеийн «Авах дүн» (сервер тооцсон)
  expectedAmount    Int              @default(0)
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedByName    String?
  /// Баталгаажуулах үеийн тооцооны хуулбар — дараа нь өөрчлөгдөхгүй
  snapshot          Json?
  /// Нягтлан гараар зассан гүйцэтгэл (0–100), зөвхөн тэр өдөрт
  perfOverride      Decimal?         @db.Decimal(5, 2)
  perfNote          String?
  perfByName        String?
  perfAt            DateTime?
  /// «Тооцоо хийсэн» тэмдэг (нягтлан)
  accountingSettled Boolean          @default(false)
  settledAt         DateTime?
  settledByName     String?
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([driverId, date])
  @@index([date, status])
}

/// Цалингийн дүрэм (хөлс, гүйцэтгэлийн босго) — «хэдэн өдрөөс хүчинтэй»; өнгөрсөн өдөр өөрчлөгдөхгүй (#82)
model SalaryRule {
  id            Int      @id @default(autoincrement())
  effectiveFrom DateTime @unique @db.Date
  rules         Json
  note          String?
  byName        String
  createdAt     DateTime @default(now())
}

/// Жолоочийн цалингийн горим: NORMAL | SPECIAL (тусгай) | REGIONAL (орон нутаг, тогтмол хөлс) — өгсөн өдрөөс
model DriverPayMode {
  id            Int      @id @default(autoincrement())
  driverId      String   @db.Uuid
  effectiveFrom DateTime @db.Date
  mode          String
  regionalRate  Int?
  byName        String
  createdAt     DateTime @default(now())

  @@unique([driverId, effectiveFrom])
}

/// Компанид өгөх өр (хуучин «Төлбөр тооцооны бүртгэл») — жолоочийн хувийн «Өрийн дэвтэр»-тэй (#79) холбоогүй
enum CompanyDebtKind {
  GOODS_NOT_RETURNED
  PRODUCT_NOT_DELIVERED
  ACCOUNTING_MISMATCH
  SETTLEMENT_DEBT
  OTHER
}

model CompanyDebt {
  id             Int             @id @default(autoincrement())
  driverId       String          @db.Uuid
  driverName     String
  kind           CompanyDebtKind
  description    String
  amount         Int
  /// PENDING | RESOLVED
  status         String          @default("PENDING")
  createdAt      DateTime        @default(now())
  createdByName  String
  resolvedAt     DateTime?
  resolvedByName String?
  resolvedNote   String?
  orderNumber    String?
  settlementId   Int?
  /// Автомат дутуу бараа (#82 6): бараа, тоо, нэгж үнэ (системийн)
  variantId      Int?
  qty            Int?
  unitPrice      Int?
  /// Аль өдрийн эцэст үүссэн
  date           DateTime?       @db.Date
  version        Int             @default(1)

  @@index([driverId, status])
  @@index([createdAt])
  @@index([resolvedAt])
}

/// Жолоочийн «Урьдчилгаа шилжүүлэх» (ADVANCE) ба «Нэмэлт барааны тооцоо» (EXTRA) — нягтлан «Зөвшөөрөх» (хуучин шиг, Авах дүнд орохгүй)
model DriverPayment {
  id             Int       @id @default(autoincrement())
  kind           String
  driverId       String    @db.Uuid
  driverName     String
  date           DateTime  @db.Date
  amount         Int
  note           String?
  approved       Boolean   @default(false)
  approvedAt     DateTime?
  approvedByName String?
  idemKey        String    @unique
  createdAt      DateTime  @default(now())

  @@index([date, kind])
  @@index([driverId, date])
}

/// Банкны гүйлгээ (Хаан банк — CSV, Gmail). status: UNMATCHED | MATCHED | PARTIAL_PAYMENT | EXCESS_AMOUNT | DUPLICATE
model BankTransaction {
  id             Int       @id @default(autoincrement())
  txDate         DateTime
  description    String
  amount         Int
  phone          String?
  orderId        Int?
  status         String    @default("UNMATCHED")
  isDuplicate    Boolean   @default(false)
  refunded       Boolean   @default(false)
  source         String    @default("CSV")
  emailMessageId String?   @unique
  importedAt     DateTime  @default(now())
  importedByName String
  matchedAt      DateTime?
  matchedByName  String?

  @@index([txDate])
  @@index([phone])
  @@index([orderId])
  @@index([status, txDate])
}

// ───────────────────────── Модуль 7а: Алдаа удирдлага (#90) ─────────────────────────

enum PenaltyType {
  OPP_ERROR
  DELIVERY_ERROR
  MARKETING_ERROR
  WAREHOUSE_ERROR
}

/// Торгууль. Устгахгүй — шалтгаантай «Цуцлах» (status CANCELLED). Цалингаас хасагдсан бол deducted.
model Penalty {
  id              Int         @id @default(autoincrement())
  type            PenaltyType
  /// Алдааны нэр (тохиргооны жагсаалтаас эсвэл автомат)
  category        String
  amount          Int
  description     String?
  userId          String      @db.Uuid
  userName        String
  orderId         Int?
  orderNumber     String?
  pageName        String?
  customerPhone   String?
  customerName    String?
  lateMinutes     Int?
  /// Асуудлаас автоматаар үүссэн
  auto            Boolean     @default(false)
  createdById     String?     @db.Uuid
  createdByName   String
  createdAt       DateTime    @default(now())
  /// ACTIVE | CANCELLED
  status          String      @default("ACTIVE")
  cancelledAt     DateTime?
  cancelledByName String?
  cancelNote      String?
  deducted        Boolean     @default(false)
  /// Модуль 7б: цалингаас хассан дүн (хэсэгчилсэн бол < amount)
  deductedAmount  Int         @default(0)
  deductedAt      DateTime?
  deductedByName  String?
  version         Int         @default(1)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([orderId])
}

// ───────────────────────── Модуль 7б: Ажилтны цалин (#93) ─────────────────────────

/// Ажилтны цалингийн тохиргоо (хуучин шиг): FIXED | ORDER_BASED
model StaffSalaryConfig {
  userId          String   @id @db.Uuid
  salaryType      String   @default("FIXED")
  baseSalary      Int      @default(0)
  bonusSalary     Int      @default(0)
  oppRatePerOrder Int      @default(0)
  dailyRate       Int      @default(0)
  bankName        String   @default("")
  bankAccount     String   @default("")
  updatedAt       DateTime @updatedAt
  updatedByName   String?
}

/// Гадны ажилтан (системд нэвтэрдэггүй)
model ExternalStaff {
  id          Int      @id @default(autoincrement())
  name        String
  jobTitle    String
  baseSalary  Int      @default(0)
  bankName    String   @default("")
  bankAccount String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

/// Ажлын хуваарь: staffKey = u:<userId> | x:<externalId>; dayType: LEAVE | SICK | ABSENT | DAY_OFF (тэмдэглээгүй = ажилласан)
model StaffWorkDay {
  staffKey  String
  date      DateTime @db.Date
  dayType   String
  note      String?
  byName    String
  updatedAt DateTime @updatedAt

  @@id([staffKey, date])
  @@index([date])
}

/// Хагас сарын цалин (1–15, 16–сүүл)
model StaffSalaryRecord {
  id                Int       @id @default(autoincrement())
  staffKey          String
  userId            String?   @db.Uuid
  externalId        Int?
  staffName         String
  staffRole         String    @default("")
  periodStart       DateTime  @db.Date
  periodEnd         DateTime  @db.Date
  periodLabel       String
  salaryType        String    @default("FIXED")
  workingDays       Int       @default(0)
  totalDays         Int       @default(0)
  dailyRate         Int       @default(0)
  baseSalary        Int       @default(0)
  bonusSalary       Int       @default(0)
  orderCount        Int       @default(0)
  orderRate         Int       @default(0)
  orderSalary       Int       @default(0)
  additions         Json      @default("[]")
  totalAdditions    Int       @default(0)
  deductions        Json      @default("[]")
  totalDeductions   Int       @default(0)
  penaltyTotal      Int       @default(0)
  penaltyDeducted   Int       @default(0)
  loans             Json      @default("[]")
  loanTotal         Int       @default(0)
  debtPayments      Json      @default("[]")
  debtTotal         Int       @default(0)
  grossSalary       Int       @default(0)
  transferSalary    Int       @default(0)
  notes             String?
  bankName          String    @default("")
  bankAccount       String    @default("")
  transferred       Boolean   @default(false)
  transferredAt     DateTime?
  transferredByName String?
  isLocked          Boolean   @default(false)
  lockedAt          DateTime?
  lockedByName      String?
  /// Цоожлоход хэрэгжүүлсэн: торгууль [{id, amount}], зээл [loanId], өрийн төлөлт [paymentId]
  applied           Json?
  createdByName     String
  updatedByName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  @@unique([staffKey, periodStart])
  @@index([periodStart])
}

/// Ажилтны өр (урт хугацааны, цалингаас хэсэгчлэн төлнө)
model StaffDebt {
  id              Int                @id @default(autoincrement())
  staffKey        String
  staffName       String
  description     String
  totalAmount     Int
  remainingAmount Int
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  createdByName   String
  payments        StaffDebtPayment[]

  @@index([staffKey, isActive])
}

model StaffDebtPayment {
  id            Int       @id @default(autoincrement())
  debtId        Int
  debt          StaffDebt @relation(fields: [debtId], references: [id])
  recordId      Int?
  periodLabel   String
  amount        Int
  note          String?
  createdAt     DateTime  @default(now())
  createdByName String

  @@index([debtId])
  @@index([recordId])
}

// ───────────── Модуль 7в — Нийлүүлэгч (гадны дэлгүүр, #96–#98) ─────────────

/// Гадны дэлгүүр (нийлүүлэгч). Барааг нь бид зарж, суутгалаа хасаад цэвэр дүнг шилжүүлнэ
model SupplierShop {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  contactName  String   @default("")
  contactPhone String   @default("")
  /// Нийлүүлэгчийн нэвтрэх эрх (SUPPLIER роль) — зөвхөн өөрийн тооцоог харна
  userId       String?  @unique @db.Uuid
  isActive     Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products    SupplierProduct[]
  deductions  SupplierDeduction[]
  days        SupplierDay[]
  adjustments SupplierAdjustment[]
}

/// Бараа ↔ дэлгүүр: [fromDate, toDate) хугацаанд (падааны өдрөөр). Нэг бараа нэг л нээлттэй хувиарлалттай (partial unique)
model SupplierProduct {
  id            Int          @id @default(autoincrement())
  shopId        Int
  shop          SupplierShop @relation(fields: [shopId], references: [id])
  productId     Int
  fromDate      DateTime     @db.Date
  /// Энэ өдрөөс эхлэн хамаарахгүй (хасагдсан). null = одоо хамаарна
  toDate        DateTime?    @db.Date
  createdByName String
  endedByName   String?
  createdAt     DateTime     @default(now())

  @@index([shopId])
  @@index([productId])
}

/// 1 ширхэгээс хасах суутгал (хуучин SupplierProductDeduction)
model SupplierDeduction {
  shopId        Int
  shop          SupplierShop @relation(fields: [shopId], references: [id])
  productId     Int
  operatorCost  Int          @default(0)
  deliveryCost  Int          @default(0)
  marketingCost Int          @default(0)
  otherCost     Int          @default(0)
  otherNote     String       @default("")
  updatedAt     DateTime     @updatedAt
  updatedByName String?

  @@id([shopId, productId])
}

/// Падааны өдрийн тооцоо. OPEN — шууд тооцогдоно; TRANSFERRED — хуулбараар түгжигдсэн
model SupplierDay {
  id                Int               @id @default(autoincrement())
  shopId            Int
  shop              SupplierShop      @relation(fields: [shopId], references: [id])
  date              DateTime          @db.Date
  status            String            @default("OPEN")
  /// Супер админы гараар засвар: { [productId]: { operatorCost, deliveryCost, marketingCost, otherCost, note } } (нийт дүн)
  overrides         Json?
  /// Шилжүүлэх үеийн бүтэн тооцоо (мөрүүд, нэмэгдэл/хасалт)
  snapshot          Json?
  sales             Int               @default(0)
  deductions        Int               @default(0)
  net               Int               @default(0)
  adjustments       Int               @default(0)
  payable           Int               @default(0)
  transferredAt     DateTime?
  transferredByName String?
  version           Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             SupplierDayItem[]

  @@unique([shopId, date])
  @@index([status])
}

/// Шилжүүлсэн өдрийн захиалга × бараа бүрийн хэсэг — дараа нь буцаалт/нэмэгдлийг илрүүлэхэд
model SupplierDayItem {
  id          Int         @id @default(autoincrement())
  dayId       Int
  day         SupplierDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  /// "o:<orderId>" эсвэл "d:<driverDocId>" (жолоочийн нэмэлт борлуулалт)
  source      String
  orderNumber String
  productId   Int
  qty         Int
  sales       Int
  /// Энэ хэсэгт ногдох суутгал (нийт)
  deduction   Int
  /// Дараа нь тохируулсан тоо (+ буцаалт, − нэмэгдэл)
  adjustedQty Int         @default(0)

  @@unique([dayId, source, productId])
}

/// Шилжүүлсний дараах буцаалт (−) / нэмэгдэл (+) / шилжүүлгэд багтаагүй өр (CARRY, −) — дараагийн шилжүүлгээс тооцогдоно
model SupplierAdjustment {
  id           Int          @id @default(autoincrement())
  shopId       Int
  shop         SupplierShop @relation(fields: [shopId], references: [id])
  kind         String
  /// Аль шилжүүлсэн өдрөөс үүссэн
  sourceDayId  Int?
  sourceDate   DateTime?    @db.Date
  orderNumber  String?
  productId    Int?
  productName  String?
  qty          Int          @default(0)
  sales        Int          @default(0)
  deduction    Int          @default(0)
  /// Шилжүүлэх дүнд нөлөөлөх (тэмдэгтэй): буцаалт −(sales − deduction)
  amount       Int
  reason       String
  /// Аль өдрийн шилжүүлэгт тооцогдсон (null = дараагийн шилжүүлэгт)
  appliedDayId Int?
  createdAt    DateTime     @default(now())

  @@index([shopId, appliedDayId])
  @@index([sourceDayId])
}

// ───────────── Модуль 7г — Барааны гарц, маркетинг (#104–#110) ─────────────

/// Барааны маркетингийн мэдээлэл: хариуцагч, «Хийсэн ✓», тэмдэглэл, одоогийн бүүст ($, бүс, AD)
model ProductMarketing {
  productId     Int       @id
  ownerId       String?   @db.Uuid
  ownerName     String?
  doneAt        DateTime?
  doneByName    String?
  note          String    @default("")
  /// Нэг бүүстийн өдрийн доллар (анх 5)
  dollar        Int       @default(5)
  /// Бүүстийн тоо (0 = унтарсан)
  zones         Int       @default(0)
  adNumber      Int?
  /// Одоогийн бүүст асаасан мөч (0 → >0); унтраахад null
  boostOnAt     DateTime?
  updatedAt     DateTime  @updatedAt
  updatedByName String?

  @@index([ownerId])
  @@index([zones])
}

/// Бүүстийн өөрчлөлт бүр (цагтай) — өдөр бүрийн бүүст, асаах/унтраах түүх, зардлыг цагаар бодно
model BoostEvent {
  id        Int      @id @default(autoincrement())
  productId Int
  at        DateTime @default(now())
  dollar    Int
  zones     Int
  adNumber  Int?
  byId      String?  @db.Uuid
  byName    String

  @@index([productId, at])
  @@index([at])
}

/// Маркетингийн пэйж: нэг пэйж — нэг маркетинг
model MarketingPage {
  pageId        Int      @id
  userId        String   @db.Uuid
  userName      String
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

/// Ажлын цонх: бараа сонгох (нэг барааг нэг л хүн — partial unique)
model WorkClaim {
  id          Int       @id @default(autoincrement())
  productId   Int
  userId      String    @db.Uuid
  userName    String
  claimedAt   DateTime  @default(now())
  /// ACTIVE | COMPLETED | RETURNED | CANCELLED | EXPIRED
  status      String    @default("ACTIVE")
  progress    Int       @default(0)
  endedAt     DateTime?
  endedByName String?

  @@index([userId, status])
  @@index([productId])
  @@index([status])
}

/// Маркетингийн өдрийн үнэлгээ (оноо, цалин → «Ажилтны цалин»-д нэмэлт орлого)
model MarketingScore {
  id           Int      @id @default(autoincrement())
  userId       String   @db.Uuid
  userName     String
  date         DateTime @db.Date
  score        Int?
  salaryAmount Int      @default(0)
  note         String   @default("")
  boostCount   Int      @default(0)
  orderCount   Int      @default(0)
  scoredById   String   @db.Uuid
  scoredByName String
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

/// «1 өдөр ажиглах» — анхааруулгыг тэр хүртэл нууна
model BoostWatch {
  id        Int      @id @default(autoincrement())
  productId Int
  until     DateTime
  byId      String   @db.Uuid
  byName    String
  createdAt DateTime @default(now())

  @@index([productId, until])
}

/// Бараа татах (#119, зөвхөн Супер админ): «Захиалсан» тэмдэг. Агуулахад орлого (RECEIPT) ормогц receivedAt бөглөгдөж,
/// нөөцийн тооцоо шинэ үлдэгдлээр дахин эхэлнэ. Нэг бараанд нэг л идэвхтэй захиалга.
model ReorderOrder {
  id          Int       @id @default(autoincrement())
  productId   Int
  qty         Int
  /// Ирэх өдөр (UB, YYYY-MM-DD)
  expectedDay String
  note        String    @default("")
  orderedAt   DateTime  @default(now())
  byName      String
  receivedAt  DateTime?
  cancelledAt DateTime?

  @@index([productId, orderedAt])
}

/// Нийлүүлэгчийн өөрийн өртөг (#122) — зөвхөн тэр нийлүүлэгч бичиж, өөрөө харна (цэвэр ашгийн тооцоонд)
model SupplierOwnCost {
  shopId    Int
  productId Int
  cost      Int
  updatedAt DateTime @updatedAt

  @@id([shopId, productId])
}
